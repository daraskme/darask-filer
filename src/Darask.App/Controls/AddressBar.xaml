<UserControl x:Class="Darask.App.AddressBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
    <Grid HorizontalAlignment="Stretch" Background="Transparent" MouseLeftButtonUp="Grid_MouseLeftButtonUp">
        <!-- 表示モード: パンくず -->
        <ItemsControl x:Name="BreadcrumbHost" Visibility="Visible" Background="Transparent">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="{Binding Name}" Appearance="Transparent"
                                   Click="BreadcrumbSegment_Click" Tag="{Binding FullPath}" />
                        <TextBlock Text="&gt;" VerticalAlignment="Center" Margin="2,0" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 編集モード: パス直接入力(Ctrl+L / クリックで切替) -->
        <ui:TextBox x:Name="EditBox" Visibility="Collapsed" HorizontalAlignment="Stretch"
                    KeyDown="EditBox_KeyDown" LostKeyboardFocus="EditBox_LostKeyboardFocus" />
    </Grid>
</UserControl>
