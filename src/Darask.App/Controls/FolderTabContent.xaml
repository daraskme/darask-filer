<UserControl x:Class="Darask.App.FolderTabContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Darask.App">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- ツールバー(戻る/進む/上/更新 + アドレスバー + フィルター + 表示切替) -->
            <RowDefinition Height="*" />      <!-- FolderView | PreviewPane -->
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <ui:Button x:Name="BackButton" Click="BackButton_Click" ToolTip="戻る (Alt+←)"
                           Padding="8" Margin="0,0,2,0">
                    <ui:SymbolIcon Symbol="ArrowLeft24" />
                </ui:Button>
                <ui:Button x:Name="ForwardButton" Click="ForwardButton_Click" ToolTip="進む (Alt+→)"
                           Padding="8" Margin="0,0,2,0">
                    <ui:SymbolIcon Symbol="ArrowRight24" />
                </ui:Button>
                <ui:Button x:Name="UpButton" Click="UpButton_Click" ToolTip="上へ (Alt+↑)"
                           Padding="8" Margin="0,0,2,0">
                    <ui:SymbolIcon Symbol="ArrowUp24" />
                </ui:Button>
                <ui:Button x:Name="RefreshButton" Click="RefreshButton_Click" ToolTip="更新 (F5)"
                           Padding="8" Margin="0,0,8,0">
                    <ui:SymbolIcon Symbol="ArrowClockwise24" />
                </ui:Button>
            </StackPanel>

            <local:AddressBar x:Name="AddressBarControl" Grid.Column="1"
                               Margin="0,0,8,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" />

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <local:FilterBox x:Name="FilterBoxControl" Width="200" Margin="0,0,8,0" VerticalAlignment="Center" />
                <ui:Button x:Name="ViewToggleButton" Click="ViewToggleButton_Click" ToolTip="表示方法の切り替え (Ctrl+Shift+1/2)"
                           Padding="8">
                    <ui:SymbolIcon x:Name="ViewToggleIcon" Symbol="Grid24" />
                </ui:Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="260" MinWidth="180" MaxWidth="520" />
            </Grid.ColumnDefinitions>

            <local:FolderView x:Name="MainFolderView" Grid.Column="0" />
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" />
            <local:PreviewPane x:Name="PreviewPaneControl" Grid.Column="2" />
        </Grid>
    </Grid>
</UserControl>
