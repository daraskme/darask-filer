<UserControl x:Class="Darask.App.NavigationPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- ごみ箱 + クイックアクセス -->
            <RowDefinition Height="*" />      <!-- ドライブツリー -->
            <RowDefinition Height="Auto" />   <!-- 履歴(左下、docs/07 #26) -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="8,8,8,4">
            <Border x:Name="RecycleBinRow" Padding="4,6" Margin="0,0,0,10" CornerRadius="4" Cursor="Hand"
                    Background="Transparent" MouseLeftButtonUp="RecycleBinRow_MouseLeftButtonUp">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Delete24" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="ごみ箱" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- 作業スペース: プロジェクトごとのタブ構成を名前付きで保存/切替(ユーザー要望機能)。 -->
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="作業スペース" Opacity="0.6" Margin="4,0,0,0" FontSize="12" VerticalAlignment="Center" />
                <ui:Button Grid.Column="1" Padding="5,1" ToolTip="現在のタブ構成を作業スペースとして保存"
                           Click="SaveWorkspaceButton_Click">
                    <ui:SymbolIcon Symbol="Add16" FontSize="11" />
                </ui:Button>
            </Grid>
            <ListBox x:Name="WorkspaceList" BorderThickness="0" Background="Transparent" Margin="0,0,0,10"
                     PreviewMouseLeftButtonUp="WorkspaceList_PreviewMouseLeftButtonUp"
                     MouseRightButtonUp="WorkspaceList_MouseRightButtonUp">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="4,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Briefcase24" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="クイックアクセス" Opacity="0.6" Margin="4,0,0,4" FontSize="12" />
            <ListBox x:Name="QuickAccessList" BorderThickness="0" Background="Transparent"
                     PreviewMouseLeftButtonUp="QuickAccessList_PreviewMouseLeftButtonUp"
                     MouseRightButtonUp="QuickAccessList_MouseRightButtonUp">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="4,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Star24" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <TreeView x:Name="Tree" Grid.Row="1" BorderThickness="0" Background="Transparent"
                  TreeViewItem.Expanded="TreeViewItem_Expanded"
                  PreviewMouseLeftButtonUp="Tree_PreviewMouseLeftButtonUp">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <TextBlock Text="{Binding DisplayName}" />
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <StackPanel Grid.Row="2" Margin="8,4,8,8" MaxHeight="210">
            <TextBlock Text="履歴" Opacity="0.6" Margin="4,0,0,4" FontSize="12" />
            <ListBox x:Name="HistoryList" BorderThickness="0" Background="Transparent" MaxHeight="180"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     PreviewMouseLeftButtonUp="HistoryList_PreviewMouseLeftButtonUp"
                     MouseRightButtonUp="HistoryList_MouseRightButtonUp">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="4,5" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="History24" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" FontSize="12" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Grid>
</UserControl>
