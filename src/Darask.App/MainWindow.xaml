<ui:FluentWindow x:Class="Darask.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Darask.App"
        Title="darask-filer" Height="700" Width="1100"
        MinHeight="400" MinWidth="600"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- TitleBar -->
            <RowDefinition Height="Auto" />   <!-- タブストリップ -->
            <RowDefinition Height="*" />      <!-- Body: NavPane | TabContentHost -->
            <RowDefinition Height="Auto" />   <!-- StatusBar -->
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="darask-filer" />

        <Grid Grid.Row="1" Margin="8,4,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ItemsControl x:Name="TabStrip" Grid.Column="0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10,7" Margin="0,0,4,0" CornerRadius="6"
                                MouseLeftButtonUp="TabChip_MouseLeftButtonUp"
                                MouseDown="TabChip_MouseDown">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Background" Value="#33808080" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" MaxWidth="140" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="11"
                                           Margin="10,0,0,0" Opacity="0.55" VerticalAlignment="Center"
                                           MouseLeftButtonUp="TabChip_Close_MouseLeftButtonUp" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ui:Button x:Name="NewTabButton" Grid.Column="1" Click="NewTabButton_Click"
                       ToolTip="新しいタブ (Ctrl+T)" Padding="8">
                <ui:SymbolIcon Symbol="Add24" />
            </ui:Button>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="120" MaxWidth="480" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <local:NavigationPane x:Name="NavPane" Grid.Column="0" />
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" />
            <Grid x:Name="TabContentHost" Grid.Column="2" />
        </Grid>

        <local:StatusBarControl x:Name="StatusBarControl" Grid.Row="3" />
    </Grid>
</ui:FluentWindow>
